# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do painel administrativo (Supabase)
#
# Copie este arquivo para `.env.local` (desenvolvimento) e cadastre as mesmas
# variáveis na Vercel: Project → Settings → Environment Variables.
# O arquivo `.env.local` NÃO vai para o Git (está no .gitignore).
#
# Passo a passo completo em docs/ADMIN-SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase  (Supabase → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA ("publishable" ou "anon public").
# É segura para ficar no navegador: quem protege os dados são as regras RLS do banco.
# NUNCA use aqui a chave secreta / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# (Alternativa legada) projetos antigos podem usar o nome abaixo em vez do anterior:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
